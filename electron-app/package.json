{
  "name": "barakat-al-manasek",
  "version": "15.3.0",
  "description": "نظام إدارة التذاكر — بركات المناسك للسفر والسياحة",
  "main": "main.js",
  "author": "بركات المناسك",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:nsis": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.barakat.manasek",
    "productName": "Barakat Al-Manasek",
    "copyright": "Copyright © 2026 بركات المناسك",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../pure-app",
        "to": "pure-app",
        "filter": [
          "**/*",
          "!**/*.ps1",
          "!**/*.vbs",
          "!**/*.log",
          "!**/*.txt",
          "!**/server.*",
          "!**/watchdog.*",
          "!**/launch.*",
          "!**/launcher.*",
          "!**/create_shortcut.*",
          "!**/CHANGELOG.md",
          "!**/node_modules/**",
          "!**/.git/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Barakat.exe",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "بركات المناسك",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "Barakat-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Barakat.exe"
    }
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@35.7.5": true
  }
}
